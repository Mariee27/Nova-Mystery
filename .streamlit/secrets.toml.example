# Copy this file to .streamlit/secrets.toml and fill in the values.
# .streamlit/secrets.toml is ignored by git: real keys never go into the repository.

# Public address of the deployed app (for the QR code). Leave out when playing locally.
# APP_BASE_URL = "https://your-app.streamlit.app"

# Key from openrouter.ai for AI-written cases. Without it, every game plays case #001.
OPENROUTER_API_KEY = "paste-your-key-here"

# Optional: another free OpenRouter model (the id ends in ":free").
# OPENROUTER_MODEL = "google/gemma-4-31b-it:free"
